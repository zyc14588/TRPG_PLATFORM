          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "ConnectionResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/ID"
        },
        "data": {
          "$ref": "#/$defs/Connection"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "SnapshotResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/ID"
        },
        "data": {
          "$ref": "#/$defs/Snapshot"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "CommandResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/ID"
        },
        "data": {
          "$ref": "#/$defs/Result"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "ControlResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/ID"
        },
        "data": {
          "$ref": "#/$defs/Control"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "ExportResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/ID"
        },
        "data": {
          "$ref": "#/$defs/Export"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "RecoveryPointResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/ID"
        },
        "data": {
          "$ref": "#/$defs/RecoveryPoint"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "AppliedResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/ID"
        },
        "data": {
          "type": "object",
          "properties": {
            "applied": {
              "const": true
            }
          },
          "required": [
            "applied"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "data"
      ],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/ID"
        },
        "error": {
