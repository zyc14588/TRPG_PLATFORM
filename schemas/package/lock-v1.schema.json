{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zyc14588/TRPG_PLATFORM/schemas/package/lock-v1.schema.json",
  "$comment": "SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0",
  "title": "TRPG Platform exact dependency lock version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root", "packages"],
  "properties": {
    "schema_version": { "const": 1 },
    "root": { "$ref": "#/$defs/packageId" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lockedPackage" }
    }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?/[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "lockedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "version", "content_hash", "features", "dependencies"],
      "properties": {
        "package_id": { "$ref": "#/$defs/packageId" },
        "version": { "$ref": "#/$defs/semver" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/packageId" }
        }
      }
    }
  }
}
