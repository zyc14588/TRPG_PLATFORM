{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zyc14588/TRPG_PLATFORM/schemas/package/manifest-v2.schema.json",
  "$comment": "SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0",
  "title": "TRPG Platform package manifest version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "package_id", "package_kind", "version",
    "display_name", "build", "rights", "capabilities"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "artifact_type": { "const": "package" },
    "package_id": { "$ref": "manifest-v1.schema.json#/$defs/packageId" },
    "package_kind": { "enum": ["game-system", "content", "assets", "ui-extension", "library"] },
    "version": { "$ref": "manifest-v1.schema.json#/$defs/semver" },
    "display_name": { "$ref": "manifest-v1.schema.json#/$defs/nonBlankString", "maxLength": 200 },
    "entrypoint": { "$ref": "manifest-v1.schema.json#/$defs/nonBlankString" },
    "lua_profile": { "$ref": "manifest-v1.schema.json#/$defs/nonBlankString" },
    "host_api": { "$ref": "manifest-v1.schema.json#/$defs/hostApi" },
    "build": { "$ref": "manifest-v1.schema.json#/$defs/build" },
    "rights": { "$ref": "manifest-v1.schema.json#/$defs/rights" },
    "capabilities": { "$ref": "manifest-v1.schema.json#/$defs/capabilities" },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "manifest-v1.schema.json#/$defs/dependency" }
    },
    "extensions": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/extension" }
    }
  },
  "dependentRequired": {
    "entrypoint": ["lua_profile", "host_api"],
    "lua_profile": ["entrypoint", "host_api"],
    "host_api": ["entrypoint", "lua_profile"]
  },
  "allOf": [
    {
      "if": { "properties": { "package_kind": { "const": "game-system" } }, "required": ["package_kind"] },
      "then": { "required": ["entrypoint", "lua_profile", "host_api"] }
    }
  ],
  "$defs": {
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace", "required", "contract_version", "schema_path", "schema_sha256",
        "payload_path", "host_api_major", "host_api_min_minor", "host_api_max_minor"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?){2,7}$",
          "not": { "pattern": "^trpg\\.platform(?:\\.|$)" }
        },
        "required": { "type": "boolean" },
        "contract_version": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "schema_path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "schema_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "payload_path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "host_api_major": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "host_api_min_minor": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "host_api_max_minor": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    }
  }
}
