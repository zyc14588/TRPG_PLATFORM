{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zyc14588/TRPG_PLATFORM/schemas/codex/governance-maintenance-contract-v1.schema.json",
  "x-section-id": "SCHEMA-CODEX-GOVERNANCE-MAINTENANCE-V1",
  "type": "object",
  "required": [
    "schema_version",
    "x-section-id",
    "maintenance_id",
    "objective",
    "reason",
    "source_blocker",
    "allowed_scope",
    "forbidden_scope",
    "normative_references",
    "acceptance",
    "tests",
    "stop_conditions",
    "bootstrap",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "x-section-id": { "$ref": "#/$defs/maintenanceId" },
    "maintenance_id": { "$ref": "#/$defs/maintenanceId" },
    "objective": { "$ref": "#/$defs/nonEmptyStrings" },
    "reason": { "type": "string", "minLength": 1 },
    "source_blocker": { "type": "string", "minLength": 1 },
    "allowed_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/routeReference" }
    },
    "forbidden_scope": { "$ref": "#/$defs/nonEmptyStrings" },
    "normative_references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/routeReference" }
    },
    "acceptance": { "$ref": "#/$defs/nonEmptyStrings" },
    "tests": { "$ref": "#/$defs/nonEmptyStrings" },
    "stop_conditions": { "$ref": "#/$defs/nonEmptyStrings" },
    "bootstrap": {
      "type": "object",
      "required": ["bootstrap_id", "authorization", "allowed_scope", "retirement_condition", "status", "retirement_evidence"],
      "properties": {
        "bootstrap_id": { "type": "string", "pattern": "^GOVERNANCE-MAINTENANCE-BOOTSTRAP-[0-9]{3}$" },
        "authorization": { "type": "string", "minLength": 1 },
        "allowed_scope": { "$ref": "#/$defs/nonEmptyStrings" },
        "retirement_condition": { "type": "string", "minLength": 1 },
        "status": { "enum": ["AUTHORIZED_ONCE", "RETIRED"] },
        "retirement_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "RETIRED" } }, "required": ["status"] },
          "then": { "properties": { "retirement_evidence": { "minItems": 1 } } },
          "else": { "properties": { "retirement_evidence": { "maxItems": 0 } } }
        }
      ],
      "additionalProperties": false
    },
    "status": { "enum": ["ACTIVE", "READY_FOR_ACCEPTANCE"] }
  },
  "$defs": {
    "maintenanceId": { "type": "string", "pattern": "^GOV-[A-Z0-9-]+$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "routeReference": {
      "type": "object",
      "required": ["path", "section_id", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "not": { "pattern": "\\*|\\?|\\[" } },
        "section_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "governance-entry",
            "governance-policy",
            "normative-section",
            "machine-contract",
            "state-summary",
            "production-code",
            "test",
            "generated-reference"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
