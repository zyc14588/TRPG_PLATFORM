{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zyc14588/TRPG_PLATFORM/schemas/codex/milestone-plan-v2.schema.json",
  "x-section-id": "SCHEMA-CODEX-MILESTONE-PLAN-V2",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "plan_version",
    "milestone",
    "status",
    "modifiable_only_in_mode",
    "next_batch_sequence",
    "batches",
    "tombstones"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "plan_id": { "type": "string", "pattern": "^M(?:0|[1-8])-MILESTONE-PLAN$" },
    "plan_version": { "type": "integer", "minimum": 0 },
    "milestone": { "$ref": "#/$defs/milestone" },
    "status": { "enum": ["NOT_GENERATED", "ACTIVE", "COMPLETE"] },
    "modifiable_only_in_mode": { "const": "PLAN" },
    "next_batch_sequence": { "type": "integer", "minimum": 1 },
    "batches": {
      "type": "array",
      "items": { "$ref": "#/$defs/batch" }
    },
    "tombstones": {
      "type": "array",
      "items": { "$ref": "#/$defs/tombstone" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "NOT_GENERATED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "plan_version": { "const": 0 },
          "next_batch_sequence": { "const": 1 },
          "batches": { "maxItems": 0 },
          "tombstones": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": { "plan_version": { "minimum": 1 } }
      }
    }
  ],
  "$defs": {
    "milestone": {
      "type": "string",
      "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8"]
    },
    "batchId": {
      "type": "string",
      "pattern": "^M(?:0|[1-8])-B[0-9]{3,}$"
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "batch": {
      "type": "object",
      "required": [
        "batch_id",
        "sequence",
        "state",
        "objective",
        "non_goals",
        "requirements",
        "allowed_scope",
        "forbidden_scope",
        "machine_contracts",
        "reading_map_sections",
        "acceptance",
        "tests",
        "stop_conditions",
        "depends_on",
        "parallel_safe",
        "dependency_independent",
        "parallel_scope_keys"
      ],
      "properties": {
        "batch_id": { "$ref": "#/$defs/batchId" },
        "sequence": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["DRAFT", "PLANNED", "FROZEN", "IMPLEMENTING", "VERIFYING", "BLOCKED", "COMPLETED"] },
        "objective": { "type": "string", "minLength": 1 },
        "non_goals": { "$ref": "#/$defs/stringArray" },
        "requirements": { "$ref": "#/$defs/stringArray" },
        "allowed_scope": { "$ref": "#/$defs/stringArray" },
        "forbidden_scope": { "$ref": "#/$defs/stringArray" },
        "machine_contracts": { "$ref": "#/$defs/stringArray" },
        "reading_map_sections": { "$ref": "#/$defs/stringArray" },
        "acceptance": { "$ref": "#/$defs/stringArray" },
        "tests": { "$ref": "#/$defs/stringArray" },
        "stop_conditions": { "$ref": "#/$defs/stringArray" },
        "depends_on": { "$ref": "#/$defs/stringArray" },
        "parallel_safe": { "type": "boolean", "default": false },
        "dependency_independent": { "type": "boolean", "default": false },
        "parallel_scope_keys": { "$ref": "#/$defs/stringArray" },
        "frozen_contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "tombstone": {
      "type": "object",
      "required": ["batch_id", "sequence", "action", "reason", "replacement_ids"],
      "properties": {
        "batch_id": { "$ref": "#/$defs/batchId" },
        "sequence": { "type": "integer", "minimum": 1 },
        "action": { "enum": ["SPLIT", "MERGED", "CANCELLED"] },
        "reason": { "type": "string", "minLength": 1 },
        "replacement_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/batchId" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
